# Run node scripts/configure-local.mjs instead of using these placeholders.
JWT_SECRET=replace-with-at-least-32-random-bytes
RABBITMQ_PASSWORD=replace-with-random-value
IDENTITY_DB_PASSWORD=replace-with-unique-identity-password
SUPPLY_DB_PASSWORD=replace-with-unique-supply-password
DISCOVERY_DB_PASSWORD=replace-with-unique-discovery-password
RESERVATION_DB_PASSWORD=replace-with-unique-reservation-password
PAYMENT_DB_PASSWORD=replace-with-unique-payment-password
NOTIFICATION_DB_PASSWORD=replace-with-unique-notification-password
AGENT_DB_PASSWORD=replace-with-unique-agent-password
AUDIT_DB_PASSWORD=replace-with-unique-audit-password
OPENCODE_SERVER_PASSWORD=replace-with-independent-background-runtime-password
OPENCODE_INFERENCE_ENABLED=false
