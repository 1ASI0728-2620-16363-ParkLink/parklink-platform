NODE_ENV=development
PORT=3007
DATABASE_URL=postgresql://agent:replace-with-unique-password@localhost:5432/agent
JWT_SECRET=replace-with-shared-development-signing-secret
AMQP_URL=amqp://agent:replace-with-broker-password@localhost:5672
CORS_ORIGINS=http://localhost:5173
COPILOT_ENABLED=false
DISCOVERY_URL=http://localhost:3003
RESERVATION_URL=http://localhost:3004
OPENCODE_URL=http://localhost:4096
OPENCODE_SERVER_PASSWORD=replace-with-isolated-runtime-secret
# Only the isolated runtime's advertised zero-cost opencode default is permitted.
# Set false for fully offline guided mode, which is explicitly identified in the UI.
OPENCODE_INFERENCE_ENABLED=true
