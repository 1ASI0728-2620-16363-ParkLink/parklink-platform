NODE_ENV=development
PORT=3003
DATABASE_URL=postgresql://discovery:replace-with-unique-password@localhost:5432/discovery
JWT_SECRET=replace-with-shared-development-signing-secret
AMQP_URL=amqp://discovery:replace-with-broker-password@localhost:5672
CORS_ORIGINS=http://localhost:5173
REDIS_URL=redis://localhost:6379
# Redis is provisioned but not yet used; PostgreSQL/PostGIS owns the durable projection.
